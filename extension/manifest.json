{
  "manifest_version": 3,
  "name": "Tradutor de Vídeos",
  "version": "0.1.0",
  "description": "Dubla vídeos do YouTube para português usando o motor local (app da barra de menus).",
  "key": "",
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://*.youtube.com/*", "http://127.0.0.1:47811/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Tradutor de Vídeos" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
